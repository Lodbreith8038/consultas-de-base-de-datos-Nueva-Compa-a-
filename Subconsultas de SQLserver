-- #1 Empleados con al menos 10 años de antigüedad que trabajan >= 15 horas en proyectos en ejecución de Ventas o Marketing
SELECT DISTINCT E.*
FROM Empleado AS E
INNER JOIN Trabaja AS T ON E.nss_Emp = T.nss_Emp
INNER JOIN Proyecto AS P ON T.numero_Pro = P.numero_Pro
INNER JOIN Departamento AS D ON P.numero_Dep = D.numero_Dep
WHERE E.fechaIng_Emp <= DATEADD(YEAR, -10, GETDATE())
  AND T.horasSem_Tra >= 15
  AND P.estado_Pro = 'E'
  AND D.nombre_Dep IN ('Ventas', 'Marketing');


-- #2 Verificar si existe alguna ciudad con sucursales de departamentos donde no se ejecute ningún proyecto
SELECT DISTINCT L.lugar_Lde AS Ciudad
FROM LugarDepartamento AS L
WHERE NOT EXISTS
(
    SELECT 1
    FROM Proyecto AS P
    WHERE P.lugar_Pro = L.lugar_Lde
);


-- #3 Empleados con el menor salario de su departamento que ingresaron en julio o diciembre
SELECT E.*
FROM Empleado AS E
WHERE E.numero_Dep IS NOT NULL
  AND E.salario_Emp = 
  (
      SELECT MIN(E2.salario_Emp)
      FROM Empleado AS E2
      WHERE E2.numero_Dep = E.numero_Dep
  )
  AND MONTH(E.fechaIng_Emp) IN (7, 12);


-- #4 Empleados que trabajan en los mismos proyectos que el empleado con más horas semanales totales (excluyendo a este último)
SELECT DISTINCT E.*
FROM Empleado AS E
INNER JOIN Trabaja AS T ON E.nss_Emp = T.nss_Emp
WHERE T.numero_Pro IN 
(
    -- Proyectos asignados al empleado con más horas semanales en total
    SELECT T_Top.numero_Pro
    FROM Trabaja AS T_Top
    WHERE T_Top.nss_Emp = (
        SELECT TOP 1 T3.nss_Emp
        FROM Trabaja AS T3
        GROUP BY T3.nss_Emp
        ORDER BY SUM(ISNULL(T3.horasSem_Tra, 0)) DESC, T3.nss_Emp ASC
    )
)
AND E.nss_Emp <> (
    -- NSS del empleado con más horas semanales en total para excluirlo
    SELECT TOP 1 T3.nss_Emp
    FROM Trabaja AS T3
    GROUP BY T3.nss_Emp
    ORDER BY SUM(ISNULL(T3.horasSem_Tra, 0)) DESC, T3.nss_Emp ASC
);
