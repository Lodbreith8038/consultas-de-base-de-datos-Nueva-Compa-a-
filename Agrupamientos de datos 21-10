-- 1. Número de empleados hombres y mujeres
SELECT sexo, COUNT(*) AS total_empleados
FROM empleado
GROUP BY sexo
ORDER BY total_empleados DESC;

-- 2. Salario mínimo por departamento
SELECT d.nombre_dept, MIN(e.salario) AS salario_minimo
FROM departamento d
INNER JOIN empleado e ON d.num_dept = e.num_dept
GROUP BY d.nombre_dept
ORDER BY salario_minimo ASC;

-- 3. Departamento con más empleados
SELECT d.nombre_dept, COUNT(e.dni) AS total_empleados
FROM departamento d
INNER JOIN empleado e ON d.num_dept = e.num_dept
GROUP BY d.nombre_dept
ORDER BY total_empleados DESC
LIMIT 1;

-- 4. Dependientes por empleado y tipo de parentesco
SELECT e.nombre, e.apellido, dep.parentesco, COUNT(dep.nombre_dependiente) AS total_dependientes
FROM empleado e
INNER JOIN dependiente dep ON e.dni = dep.dni_empleado
GROUP BY e.dni, e.nombre, e.apellido, dep.parentesco
ORDER BY e.apellido, e.nombre, dep.parentesco;

-- 5. Proyectos controlados por departamento según su estado
SELECT d.nombre_dept, p.estado, COUNT(p.num_proy) AS total_proyectos
FROM departamento d
INNER JOIN proyecto p ON d.num_dept = p.num_dept
GROUP BY d.nombre_dept, p.estado
ORDER BY d.nombre_dept, p.estado;
