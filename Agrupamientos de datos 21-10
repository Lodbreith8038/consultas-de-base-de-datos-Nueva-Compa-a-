-- 1. Número de empleados hombres y mujeres
SELECT 
    CASE 
        WHEN sexo_Emp = 1 THEN 'Hombre'
        ELSE 'Mujer'
    END AS sexo,
    COUNT(*) AS total_empleados
FROM Empleado
GROUP BY 
    CASE 
        WHEN sexo_Emp = 1 THEN 'Hombre'
        ELSE 'Mujer'
    END
ORDER BY total_empleados DESC;

-- 2. Salario mínimo por departamento
SELECT 
    d.nombre_Dep,
    MIN(e.salario_Emp) AS salario_minimo
FROM Departamento d
INNER JOIN Empleado e ON d.numero_Dep = e.numero_Dep
GROUP BY d.nombre_Dep
ORDER BY salario_minimo ASC;

-- 3. Departamento con más empleados
SELECT TOP 1
    d.nombre_Dep,
    COUNT(e.nss_Emp) AS total_empleados
FROM Departamento d
INNER JOIN Empleado e ON d.numero_Dep = e.numero_Dep
GROUP BY d.nombre_Dep
ORDER BY total_empleados DESC;

-- 4. Dependientes por empleado y tipo de parentesco
SELECT 
    CONCAT(e.nombre_Emp, ' ', e.apellidoPat_Emp, ' ', e.apellidoMat_Emp) AS nombre_completo,
    dep.parentesco_Depe,
    COUNT(*) AS total_dependientes
FROM Empleado e
INNER JOIN Dependiente dep ON e.nss_Emp = dep.nss_Emp
GROUP BY 
    CONCAT(e.nombre_Emp, ' ', e.apellidoPat_Emp, ' ', e.apellidoMat_Emp),
    dep.parentesco_Depe
ORDER BY nombre_completo, dep.parentesco_Depe;

-- 5. Proyectos controlados por departamento según su estado
SELECT 
    d.nombre_Dep,
    p.estado_Pro,
    COUNT(p.numero_Pro) AS total_proyectos
FROM Departamento d
INNER JOIN Proyecto p ON d.numero_Dep = p.numero_Dep
GROUP BY d.nombre_Dep, p.estado_Pro
ORDER BY d.nombre_Dep, p.estado_Pro;
